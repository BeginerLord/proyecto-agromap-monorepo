# ─── Servidor ───────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ─── Base de datos (MongoDB local) ──────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/agromap

# ─── CORS (origen del frontend, separados por coma) ─────
CORS_ORIGIN=http://localhost:5173

# ─── JWT (se envían SOLO en cookies httpOnly) ───────────
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-por-uno-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresco-por-uno-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookies ────────────────────────────────────────────
COOKIE_SECRET=cambia-este-secreto-de-cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ─── Rate limit ─────────────────────────────────────────
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# ─── Sensores (patrón adapter) ──────────────────────────
# Proveedor por defecto: mock | http  (agrega los tuyos en src/adapters/sensors)
SENSORS_ENABLED=true
SENSOR_DEFAULT_PROVIDER=mock
# Clave que deben enviar los dispositivos/gateways en el header x-sensor-key
SENSOR_INGEST_KEY=cambia-esta-clave-de-ingesta
# Configuración del adapter HTTP genérico (cuando exista la API del proveedor)
SENSOR_HTTP_BASE_URL=
SENSOR_HTTP_TOKEN=

# ─── Seed ───────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@agromap.local
SEED_ADMIN_PASSWORD=Admin12345*
