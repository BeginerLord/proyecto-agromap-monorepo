# ─── Servidor ───────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ─── Base de datos (MongoDB local) ──────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/agromap

# ─── CORS (origen del frontend, separados por coma) ─────
CORS_ORIGIN=http://localhost:5173

# ─── JWT (se envían SOLO en cookies httpOnly) ───────────
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-por-uno-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresco-por-uno-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Acceso sin login (temporal) ────────────────────────
# true = el panel funciona sin iniciar sesión (todo se registra como el administrador principal).
# Ponlo en false para volver a exigir login.
AUTH_BYPASS=false

# ─── Cookies ────────────────────────────────────────────
COOKIE_SECRET=cambia-este-secreto-de-cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ─── Rate limit ─────────────────────────────────────────
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# ─── Evidencias (imágenes) ─────────────────────────────
# Carpeta donde se guardan las fotos subidas (se sirve en /uploads)
UPLOADS_DIR=uploads
UPLOAD_MAX_MB=5

# ─── Almacenamiento de imágenes: Backblaze B2 (API compatible con S3) ──
# s3 = Backblaze B2 · local = carpeta UPLOADS_DIR. Si eliges s3 y faltan las claves,
# la API sigue funcionando con almacenamiento local y lo avisa en el log.
STORAGE_DRIVER=s3
# Endpoint del bucket (B2 → Buckets → "Endpoint"), p. ej. https://s3.us-east-005.backblazeb2.com
S3_ENDPOINT=
# Región = segmento del endpoint (us-east-005). Vacío = se deduce del endpoint
S3_REGION=
S3_BUCKET=
# B2 → Application Keys: "keyID" y "applicationKey" (la clave solo se muestra una vez)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Carpeta opcional dentro del bucket, p. ej. agromap
S3_KEY_PREFIX=agromap
# Solo si el bucket es PÚBLICO: URL base de descarga, p. ej. https://f005.backblazeb2.com/file/NOMBRE-BUCKET
# Vacío (bucket privado, recomendado) = la API sirve las imágenes en /uploads/... y nginx las cachea
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ─── Optimización de imágenes ───────────────────────────
# Toda foto subida se convierte a WebP (sin metadatos/GPS) y se reduce si supera este lado mayor
IMAGE_MAX_DIMENSION=2048
# Calidad WebP 1-100 (82 = muy buena calidad con poco peso)
IMAGE_WEBP_QUALITY=82

# ─── Mapbox ────────────────────────────────────────────
# Token público de Mapbox (empieza por pk.). Se usa en el mapa del panel/sitio y para
# generar UNA imagen estática por predio al registrarlo (se reutiliza sin volver a pedirla).
# Recomendado: restringir el token por URL en la cuenta de Mapbox.
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/outdoors-v12
MAPBOX_SNAPSHOTS=true

# ─── Sensores (patrón adapter) ──────────────────────────
# Proveedor por defecto: mock | http  (agrega los tuyos en src/adapters/sensors)
SENSORS_ENABLED=true
SENSOR_DEFAULT_PROVIDER=mock
# Lecturas fuera de rango generan alertas en la bitácora (no se repiten durante el enfriamiento)
SENSOR_ALERTS_ENABLED=true
SENSOR_ALERT_COOLDOWN_HOURS=6
# Clave que deben enviar los dispositivos/gateways en el header x-sensor-key
SENSOR_INGEST_KEY=cambia-esta-clave-de-ingesta
# Configuración del adapter HTTP genérico (cuando exista la API del proveedor)
SENSOR_HTTP_BASE_URL=
SENSOR_HTTP_TOKEN=

# ─── Seed ───────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@agromap.local
SEED_ADMIN_PASSWORD=Admin12345*
