# URL base de la API. En desarrollo se usa el proxy de Vite (/api → backend) para que
# las cookies httpOnly sean del mismo origen.
VITE_API_URL=/api/v1
# Destino del proxy de desarrollo (backend Fastify)
VITE_API_PROXY_TARGET=http://localhost:3000
# Centro del mapa por defecto (Cereté, Córdoba)
VITE_MAP_CENTER_LAT=8.8853
VITE_MAP_CENTER_LNG=-75.7917
VITE_MAP_ZOOM=12
# Servidor de teselas del mapa (XYZ). OpenStreetMap por defecto
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
