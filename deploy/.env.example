# Copia a deploy/.env (no se sube a git) y completa los valores.
DOMAIN=agromap.com.co
# Correo para avisos de caducidad de Let's Encrypt
LETSENCRYPT_EMAIL=
# Usuario de aplicación de MongoDB (stack ~/mongodb-stack)
MONGO_APP_USER=agromap
MONGO_APP_PASSWORD=
MONGO_APP_DB=agromap
# Red "edge" del stack de MongoDB (nombre real: docker network ls)
MONGO_EDGE_NETWORK=mongodb-stack_edge
# Igual que AUTH_BYPASS en apps/backend/.env
VITE_AUTH_BYPASS=true
